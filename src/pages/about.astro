---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`关于 | ${SITE_TITLE}`}
			description="好读是一个中文慢阅读策展站。在信息过载的时代，只读值得读的。"
		/>
		<style>
			.about {
				max-width: 640px;
				margin: 0 auto;
				padding: 3em 1em 4em;
			}
			h1 {
				font-size: 2.2em;
				margin: 0 0 0.5em;
				color: var(--accent);
			}
			.tagline {
				margin: 0 0 2em;
				font-size: 1.25em;
				color: rgb(var(--black));
			}
			.copy {
				padding-top: 1.8em;
				border-top: 1px solid var(--border-light);
			}
			.copy p {
				margin: 0 0 1.2em;
			}
			.signature {
				padding-top: 0.8em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			@media (max-width: 720px) {
				.about {
					padding-top: 2em;
				}
				h1 {
					font-size: 1.8em;
				}
				.tagline {
					font-size: 1.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about">
			<h1>关于「好读」</h1>
			<p class="tagline">在信息过载的时代，只读值得读的。</p>

			<div class="copy">
				<p>
					「好读」是一个中文慢阅读策展站。我从日常阅读中挑选真正值得花时间的文章，整理成更适合中文阅读的版本。
				</p>
				<p>
					不追热点，不追数量。关注 AI、健康，以及一句话就能说清的好想法。
				</p>
				<p class="signature">由开封维护 · 免费阅读 · 无广告</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
